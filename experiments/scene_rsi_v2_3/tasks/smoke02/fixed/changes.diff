 def prepare_edit_mesh(obj):
-    obj.data = obj.data
+    """Detach shared mesh storage before an object-local edit.
+
+    Material slots linked to DATA belong to the mesh, as do vertices.
+    Copying the mesh isolates both without changing transforms or parenting.
+    Materials remain shared until an editor explicitly copies them.
+    """
+    if obj.type != 'MESH' or obj.data is None:
+        raise TypeError('Mesh editing requires a mesh object')
+    if obj.data.users > 1:
+        obj.data = obj.data.copy()
 
 
