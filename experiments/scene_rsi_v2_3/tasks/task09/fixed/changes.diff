+def _world_z_bounds(root, depsgraph):
+    """Return evaluated world-space mesh bounds for an object or assembly."""
+    from mathutils import Vector
+    bottom = float('inf')
+    top = float('-inf')
+    for obj in [root, *root.children_recursive]:
+        if obj.type != 'MESH':
+            continue
+        evaluated = obj.evaluated_get(depsgraph)
+        if not evaluated.data.vertices:
+            continue
+        world = evaluated.matrix_world
+        for corner in evaluated.bound_box:
+            z = (world @ Vector(corner)).z
+            bottom = min(bottom, z)
+            top = max(top, z)
+    if bottom == float('inf'):
+        raise ValueError(f'No mesh geometry for support bounds: {root.name}')
+    return bottom, top
+
